<?xml version="1.0"?>
<ruleset name="WP Live Hype">
	<description>WordPress Coding Standards and PHP 7.4+ compatibility for WP Live Hype.</description>
	<file>wp-live-hype</file>
	<exclude-pattern>wp-live-hype/languages/*</exclude-pattern>
	<!-- "Silence is golden" directory stubs. -->
	<exclude-pattern>*/index.php</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.2"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-live-hype"/>
			</property>
		</properties>
	</rule>
</ruleset>
